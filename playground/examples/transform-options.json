{
  "title": "Configure transform adapters and shared storage",
  "id": "transform-options",
  "category": "configure-transforms",
  "tags": ["options", "adapters", "shared", "buffer-mode", "advanced"],
  "aiSubset": "incompatible",
  "description": "Demonstrates per-transform OPTIONS configuration.",
  "showContracts": false,
  "program": [
    "TRANSFORM OptionsDemo OPTIONS {",
    "    mode: buffer",
    "    input: { adapter: json() }",
    "    output: { adapter: json() }",
    "    shared: [ cache SINGLE ]",
    "} {",
    "    OUTPUT { greeting: \"Hello, \" + input.name }",
    "}"
  ],
  "input": {
    "name": "Riley"
  },
  "expectedOutput": {
    "greeting": "Hello, Riley"
  },
  "diagnosticExpectation": {
    "success": true,
    "subsetCompatibility": "INCOMPATIBLE",
    "diagnostics": [
      {
        "code": "unsupported_in_ai_subset",
        "category": "unsupported-subset"
      }
    ]
  }
}
