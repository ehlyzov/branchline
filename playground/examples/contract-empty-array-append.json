{
  "title": "Inspect contracts when building an array",
  "id": "contract-empty-array-append",
  "category": "contracts",
  "tags": ["contract-inference", "arrays", "foreach", "append", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Demonstrates stable output typing with FOR EACH filtering and += into an array seeded with [].",
  "showContracts": true,
  "program": [
    "LET normalized = []",
    "FOR EACH suite IN input.suites WHERE suite != NULL {",
    "    normalized += {",
    "        name: suite[\"name\"] ?? \"unknown\",",
    "        tests: NUMBER(suite[\"tests\"] ?? 0)",
    "    }",
    "}",
    "OUTPUT {",
    "    suites: normalized",
    "}"
  ],
  "input": {
    "suites": [
      {
        "name": "api",
        "tests": 4
      },
      null,
      {
        "name": "web",
        "tests": 6
      }
    ]
  },
  "expectedOutput": {
    "suites": [
      {
        "name": "api",
        "tests": 4
      },
      {
        "name": "web",
        "tests": 6
      }
    ]
  },
  "contractExpectation": {
    "success": true,
    "subsetCompatibility": "COMPATIBLE",
    "transforms": [
      {
        "mergedContract": {
          "output": {
            "root": {
              "kind": "object",
              "children": {
                "suites": {
                  "kind": "array",
                  "element": {
                    "kind": "object"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
