{
  "title": "Update and remove object or list entries",
  "id": "stdlib-core-put-delete",
  "category": "reshape-data",
  "tags": ["put", "delete", "immutable-update", "objects", "lists", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Use PUT and DELETE to update objects and lists immutably.",
  "program": [
    "LET updatedUser = PUT(input.user, \"role\", \"reviewer\")",
    "LET removedField = DELETE(updatedUser, \"legacy_id\")",
    "",
    "LET appendedTag = PUT(input.tags, LENGTH(input.tags), \"vip\")",
    "LET deletedTag = DELETE(appendedTag, 1)",
    "",
    "OUTPUT {",
    "    original_user: input.user,",
    "    updated_user: updatedUser,",
    "    removed_field: removedField,",
    "    original_tags: input.tags,",
    "    appended_tag: appendedTag,",
    "    deleted_tag: deletedTag",
    "}"
  ],
  "input": {
    "user": {
      "id": 88,
      "role": "author",
      "legacy_id": "old-1"
    },
    "tags": [
      "new",
      "beta",
      "owner"
    ]
  },
  "expectedOutput": {
    "original_user": {
      "id": 88,
      "role": "author",
      "legacy_id": "old-1"
    },
    "updated_user": {
      "id": 88,
      "role": "reviewer",
      "legacy_id": "old-1"
    },
    "removed_field": {
      "id": 88,
      "role": "reviewer"
    },
    "original_tags": [
      "new",
      "beta",
      "owner"
    ],
    "appended_tag": [
      "new",
      "beta",
      "owner",
      "vip"
    ],
    "deleted_tag": [
      "new",
      "owner",
      "vip"
    ]
  }
}
