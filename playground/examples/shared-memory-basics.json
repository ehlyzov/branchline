{
  "title": "Write a timestamp to shared state",
  "aiSubset": "unknown",
  "tags": ["shared-memory", "writes", "now"],
  "category": "state-and-time",
  "id": "shared-memory-basics",
  "description": "Declare shared memory and write session state. Reading/waiting requires host integration.",
  "shared": [
    {
      "name": "session",
      "kind": "MANY"
    }
  ],
  "program": [
    "LET key = input.userId ?? \"guest\"",
    "SET session[key] = {",
    "    userId: key,",
    "    lastSeen: NOW()",
    "}",
    "",
    "OUTPUT {",
    "    sharedKey: key,",
    "    status: \"updated shared state\"",
    "}"
  ],
  "input": {
    "userId": "riley"
  }
}
