{
  "title": "Inspect paths through nested data",
  "id": "stdlib-core-walk",
  "category": "inspect-data",
  "tags": ["walk", "collect", "nested-data", "paths", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Traverse nested objects/lists with WALK and inspect the resulting path metadata.",
  "program": [
    "LET entries = COLLECT(WALK(input.document))",
    "",
    "OUTPUT {",
    "    paths: MAP(entries, (node) -> JOIN(node.path, \".\")),",
    "    leaves: FILTER(entries, (node) -> node.isLeaf),",
    "    summary: {",
    "        depth: MAX(MAP(entries, (node) -> node.depth)),",
    "        total_nodes: LENGTH(entries)",
    "    }",
    "}"
  ],
  "input": {
    "document": {
      "id": "doc-5",
      "title": "Nested",
      "items": [
        {
          "sku": "a1",
          "qty": 2
        },
        {
          "sku": "b2",
          "qty": 1
        }
      ]
    }
  }
}
