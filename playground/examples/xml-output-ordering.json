{
  "title": "Control XML element order and namespaces",
  "id": "xml-output-ordering",
  "category": "xml-data",
  "tags": ["xml-output", "ordering", "namespaces", "attributes", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Builds an XML-shaped object using @order and @xmlns for deterministic XML serialization.",
  "program": [
    "OUTPUT {",
    "    invoice: {",
    "        \"@xmlns\": { x: \"urn:line-items\" },",
    "        \"@id\": \"INV-7\",",
    "        \"@order\": [\"total\", \"x:item\"],",
    "        customer: { \"$\": \"Ada\" },",
    "        \"x:item\": [",
    "            { \"@sku\": \"A\", \"$\": \"2\" },",
    "            { \"@sku\": \"B\", \"$\": \"1\" }",
    "        ],",
    "        total: { \"$\": \"3\" }",
    "    }",
    "}"
  ],
  "input": {},
  "expectedOutput": {
    "invoice": {
      "@xmlns": {
        "x": "urn:line-items"
      },
      "@id": "INV-7",
      "@order": [
        "total",
        "x:item"
      ],
      "customer": {
        "$": "Ada"
      },
      "x:item": [
        {
          "@sku": "A",
          "$": "2"
        },
        {
          "@sku": "B",
          "$": "1"
        }
      ],
      "total": {
        "$": "3"
      }
    }
  }
}
