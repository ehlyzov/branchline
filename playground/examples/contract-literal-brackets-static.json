{
  "title": "Inspect contracts for literal bracket paths",
  "id": "contract-literal-brackets-static",
  "category": "contracts",
  "tags": ["literal-brackets", "static-paths", "xml-attributes", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Shows that literal bracket paths (e.g. suite[\"@name\"]) are inferred as static paths instead of opaque dynamic keys.",
  "showContracts": true,
  "program": [
    "LET suiteName = input.testsuites[\"@name\"] ?? \"missing\"",
    "LET tests = NUMBER(input.testsuites[\"@tests\"] ?? 0)",
    "OUTPUT {",
    "    suite_name: suiteName,",
    "    tests: tests",
    "}"
  ],
  "input": {
    "testsuites": {
      "@name": "suite-a",
      "@tests": 5
    }
  },
  "expectedOutput": {
    "suite_name": "suite-a",
    "tests": 5
  },
  "contractExpectation": {
    "success": true,
    "subsetCompatibility": "COMPATIBLE",
    "transforms": [
      {
        "mergedContract": {
          "output": {
            "root": {
              "children": {
                "tests": {
                  "kind": "number"
                }
              }
            }
          }
        }
      }
    ]
  }
}
