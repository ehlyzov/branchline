{
  "title": "Declare nullable input and output contracts",
  "id": "contract-nullable-precision",
  "category": "contracts",
  "tags": ["nullable", "typed-signature", "contract-json", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Demonstrate precise nullable typing in signatures with canonical contract JSON and closed explicit output records.",
  "program": [
    "TRANSFORM NullablePrecision(input: { profile: { id: string, alias?: string?, tags?: [string]? } }) -> { profile: { id: string, alias?: string?, tags?: [string]? } } {",
    "    OUTPUT {",
    "        profile: {",
    "            id: input.profile.id,",
    "            alias: input.profile.alias ?? null,",
    "            tags: input.profile.tags ?? null",
    "        }",
    "    }",
    "}"
  ],
  "input": {
    "profile": {
      "id": "u-100",
      "alias": null,
      "tags": ["alpha", "beta"]
    }
  },
  "contractExpectation": {
    "success": true,
    "subsetCompatibility": "COMPATIBLE",
    "transforms": [
      {
        "name": "NullablePrecision",
        "contractSource": "explicit",
        "mergedContract": {
          "output": {
            "root": {
              "kind": "object",
              "children": {
                "profile": {
                  "kind": "object"
                }
              }
            }
          }
        }
      }
    ]
  }
}
