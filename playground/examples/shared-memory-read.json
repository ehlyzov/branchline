{
  "title": "Read a session from shared state",
  "id": "shared-memory-read",
  "category": "state-and-time",
  "tags": ["shared-memory", "await-shared", "state", "advanced"],
  "aiSubset": "incompatible",
  "description": "Reads session state from shared storage. Run \"Shared Memory: SHARED and Writes\" in another playground tab (same origin) to seed data, then run this example with the same userId.",
  "shared": [
    {
      "name": "session",
      "kind": "MANY"
    }
  ],
  "program": [
    "LET key = input.userId ?? \"guest\"",
    "LET snapshot = session[key]",
    "LET hasValue = snapshot != null",
    "",
    "OUTPUT {",
    "    sharedKey: key,",
    "    found: hasValue,",
    "    session: snapshot",
    "}"
  ],
  "input": {
    "userId": "riley"
  },
  "expectedOutput": {
    "sharedKey": "riley",
    "found": false,
    "session": null
  },
  "diagnosticExpectation": {
    "success": true,
    "subsetCompatibility": "INCOMPATIBLE",
    "diagnostics": [
      {
        "code": "unsupported_in_ai_subset",
        "category": "unsupported-subset"
      }
    ]
  }
}
