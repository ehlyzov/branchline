{
  "name": "branchline-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run test",
    "build": "vite build",
    "test": "npm run test:first-success && npm run test:worker-deps && npm run test:catalog && npm run test:xml-input && npm run test:wrapper-diagnostics && npm run test:journey && npm run test:recipes",
    "test:worker-deps": "node scripts/check-worker-deps.mjs",
    "test:catalog": "node scripts/test-catalog-metadata.mjs",
    "test:xml-input": "node scripts/test-xml-input.mjs",
    "test:wrapper-diagnostics": "node scripts/test-wrapper-diagnostics.mjs",
    "sync:first-success": "node scripts/sync-first-success.mjs",
    "test:first-success": "node scripts/sync-first-success.mjs --check && node scripts/test-first-success-runtime.mjs",
    "test:journey": "node scripts/test-journey.mjs",
    "sync:recipes": "node scripts/sync-recipes.mjs",
    "test:recipes": "node scripts/sync-recipes.mjs --check && node scripts/test-recipes-runtime.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "monaco-editor": "^0.43.0",
    "fast-xml-parser": "^4.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
